# =========================================================================
# SAHAYAK (सहायक) - FRONTEND CONFIGURATION (.env)
# =========================================================================

# Backend API Base URL (Render Cloud or Localhost)
# For Vercel production: set to your Render service URL, e.g., https://sahayak-backend.onrender.com
# For local development: http://localhost:8080 (or leave unset for automatic fallback)
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api

# Supabase Realtime Client Configuration
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-PUBLIC-KEY]
